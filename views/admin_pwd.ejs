<!DOCTYPE html>
<html>
<head>
    <title>PWD Management - REACT</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: rgb(245, 246, 248);
            min-height: 100vh;
        }

        /* ── HEADER (original, unchanged) ── */
        header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            padding: 0.5rem 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        nav {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            padding: 10px 20px;
        }
        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: #f2f4f7ff;
        }
        .nav-links {
            margin-left: auto;
            display: flex;
            gap: 30px;
            list-style: none;
        }
        .nav-links a {
            text-decoration: none;
            color: white;
            font-weight: 500;
            font-size: 16px;
        }

        /* ── PAGE ── */
        .dashboard-container {
            max-width: 1250px;
            margin: 40px auto;
            padding: 20px;
        }

        h2 {
            color: #2c5aa0;
            margin-bottom: 20px;
            font-size: 1.4rem;
        }

        /* ── TABLE CARD WRAPPER ── */
        .table-wrap {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 6px 32px rgba(102, 126, 234, 0.2);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        /* HEAD — same gradient as navbar */
        thead tr {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }
        thead th {
            padding: 14px 16px;
            text-align: left;
            font-size: 12px;
            font-weight: 600;
            color: rgba(255,255,255,0.88);
            letter-spacing: 0.8px;
            text-transform: uppercase;
            border: none;
            white-space: nowrap;
        }
        thead th:first-child { padding-left: 24px; }
        thead th:last-child  { padding-right: 24px; min-width: 270px; }

        /* BODY */
        tbody tr {
            border-bottom: 1px solid #eaecf8;
            transition: background 0.14s;
        }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:nth-child(even) { background: #f6f7ff; }
        tbody tr:hover { background: #eef1ff; }

        td {
            padding: 15px 16px;
            font-size: 13.5px;
            color: #333;
            vertical-align: middle;
        }
        td:first-child { padding-left: 24px; font-weight: 600; color: #2c3e70; }
        td:last-child  { padding-right: 24px; vertical-align: top; padding-top: 18px; }

        /* skill pills */
        .skill-pill {
            display: inline-block;
            background: #eef1ff;
            color: #667eea;
            border: 1px solid #c5cef7;
            font-size: 11px;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 20px;
            margin: 2px 2px 2px 0;
        }

        /* ── FORM inside last column ── */
        .job-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
        }
        .job-form .full { grid-column: 1 / -1; }

        .job-form input,
        .job-form select,
        .job-form textarea {
            width: 100%;
            padding: 7px 10px;
            font-size: 12px;
            font-family: "Segoe UI", sans-serif;
            border: 1px solid #d5d9f0;
            border-radius: 7px;
            background: #f8f9ff;
            color: #333;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .job-form input:focus,
        .job-form select:focus,
        .job-form textarea:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.13);
            background: #fff;
        }
        .job-form textarea {
            resize: none;
            grid-column: 1 / -1;
            min-height: 62px;
        }

        .send-btn {
            grid-column: 1 / -1;
            display: flex;
            justify-content: flex-end;
        }

        .btn {
            padding: 7px 18px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-family: "Segoe UI", sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.15s, transform 0.1s;
        }
        .btn:hover  { opacity: 0.88; }
        .btn:active { transform: scale(0.97); }
        .btn svg { width: 13px; height: 13px; }

        /* empty state */
        .empty td {
            text-align: center;
            padding: 60px;
            color: #888;
            font-size: 14px;
        }

        /* ── FOOTER (original) ── */
        footer {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #f2f4f7ff;
            text-align: center;
            padding: 20px 0;
            margin-top: 40px;
            font-size: 13px;
        }
    </style>
</head>
<body>

<header>
    <nav>
        <div class="logo">
          <img
            src="/images/logo.jpeg"
            alt="REACT Logo"
            style="
              height: 45px;
              width: auto;
              vertical-align: middle;
              margin-right: 0.4rem;
            "
          />REACT
        </div>
        <ul class="nav-links">
           <li><a href="/admin">Dashboard</a></li>
            <li><a href="/admin_pwd_menu">PWD</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </nav>
</header>

<div class="dashboard-container">

    <h2>PWD Candidate Management</h2>
        <% if (query && query.success) { %>
        <script>
            alert("✅ Job sent successfully to candidate!");
        </script>
        <% } %>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Education</th>
                    <th>Experience</th>
                    <th>Preferred Job Role</th>
                    <th>Skills</th>
                    <th>Send Job Details</th>
                </tr>
            </thead>
            <tbody>

    <% if (candidates && candidates.length > 0) { %>

        <% candidates.forEach(function(candidate) { %>
        <tr>
            <td><%= candidate.fullName %></td>
            <td><%= candidate.education %></td>
            <td><%= candidate.experience %></td>
            <td><%= candidate.preferredJobRole %></td>
            <td>
                <% if (candidate.skills && candidate.skills.length > 0) { %>
                    <% candidate.skills.forEach(function(skill) { %>
                        <span class="skill-pill"><%= skill %></span>
                    <% }) %>
                <% } else { %>
                    —
                <% } %>
            </td>

            <td>
                <form action="/admin/jobs/add/<%= candidate.userId._id %>" method="POST" class="job-form">

                    <input type="text" name="jobTitle" placeholder="Job Title" required>

                    <input type="text" name="company" placeholder="Company Name" required>

                    <input type="text" name="location" placeholder="Location" required>

                    <select name="jobType" required>
                        <option value="">Job Type</option>
                        <option>Full Time</option>
                        <option>Part Time</option>
                        <option>Work From Home</option>
                        <option>Internship</option>
                    </select>

                    <input type="text" name="salary" placeholder="Salary" class="full" required>

                    <textarea name="description" placeholder="Job Description" required></textarea>

                    <div class="send-btn">
                        <button type="submit" class="btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12
                                    59.768 59.768 0 0 1 3.27 20.875L5.999 12zm0 0h7.5" />
                            </svg>
                            Send Job
                        </button>
                    </div>

                </form>
                 <a href="/admin/jobs/<%= candidate.userId._id %>" class="btn" style="margin-top:6px;">
                    View Job History
                </a>
            </td>
        </tr>
        <% }) %>

    <% } else { %>
        <tr class="empty">
            <td colspan="6">No candidates available.</td>
        </tr>
    <% } %>

</tbody>
        </table>
    </div>

</div>

<footer>
    © 2026 REACT | Admin - PWD Management
</footer>

</body>
</html>