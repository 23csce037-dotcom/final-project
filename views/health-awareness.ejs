<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Health Awareness Programs - REACT</title>
<style>
body{
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  background:#f4f6f9;
  margin:0;
  color:#333;
}

/* HERO */
.hero{
  background: linear-gradient(135deg,#667eea,#764ba2);
  color:white;
  padding:4rem 2rem;
  text-align:center;
}
.hero h1{
  font-size:2.5rem;
}
.hero p{
  margin-top:0.5rem;
  font-size:1.2rem;
}

/* Details Section */
.details-section{
  max-width: 1000px;
  margin: 2rem auto;
  padding: 2rem;
  background: white;
  border-radius: 12px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

.details-section h2{
  color:#2c5aa0;
  margin-bottom:1rem;
}

.details-section p{
  font-size:1.1rem;
  line-height:1.6;
}

/* Slider Styles */
.slider-container{
  position: relative;
  max-width: 1000px;
  margin: 3rem auto;
  overflow: hidden;
  border-radius: 15px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.slider-wrapper{
  display: flex;
  transition: transform 0.5s ease-in-out;
}

.slider-slide{
  min-width: 100%;
  position: relative;
}

.slider-slide img{
  width: 100%;
  height: 500px;
  object-fit: cover;
  display: block;
}

.slide-caption{
  position: absolute;
  bottom: 20px;
  left: 20px;
  background: rgba(0,0,0,0.6);
  color: white;
  padding: 1rem 1.5rem;
  border-radius: 8px;
}

/* Navigation Buttons */
.slider-btn{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.5);
  color:white;
  border:none;
  font-size:2rem;
  padding:0.5rem 1rem;
  cursor:pointer;
  border-radius: 5px;
}
.prev{ left: 10px; }
.next{ right: 10px; }

/* Back Button */
.back-btn{
  display:inline-block;
  margin:2rem auto 4rem;
  padding:0.7rem 1.5rem;
  background:linear-gradient(135deg,#667eea,#764ba2);
  color:white;
  text-decoration:none;
  border-radius:6px;
  text-align:center;
}

/* FOOTER */
.main-footer {
  background: #34495e;
  color: #ffffff;
  padding: 3rem 2rem 2rem;
  margin-top: 4rem;
}
.footer-bottom {
  text-align: center;
  margin-top: 2rem;
  border-top: 1px solid rgba(255,255,255,0.2);
  padding-top: 1rem;
  font-size: 0.9rem;
}
</style>
</head>

<body>
<section class="hero">
  <h1>Health Awareness Programs</h1>
  <p>Join our volunteering programs and create impact in community health</p>
</section>

<!-- Details Section About Health Awareness Programs -->
<section class="details-section">
  <h2>Health Awareness Volunteering Programs</h2>
  <p>
    Our Health Awareness volunteering programs aim to improve community health by engaging volunteers in activities such as organizing health camps, educating people about nutrition, conducting fitness and wellness workshops, and promoting preventive healthcare practices.
  </p>
  <p>
    Volunteers will gain hands-on experience in community outreach, health education, and program coordination, while making a real difference in the lives of people. These programs are suitable for students, professionals, and anyone passionate about public health.
  </p>
</section>

<!-- Image Slider Section -->
<section class="image-slider-section">
  <div class="slider-container">
    <div class="slider-wrapper" id="sliderWrapper">

      <!-- Slide 1 -->
      <div class="slider-slide">
        <img src="https://images.unsplash.com/photo-1584515933487-779824d29309?auto=format&fit=crop&w=1200&q=80" alt="Community Health Camp" />
        <div class="slide-caption">
          <h3>Community Health Camp</h3>
          <p>Participate in health checkups and awareness programs</p>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="slider-slide">
        <img src="https://qvt.org.uk/wp-content/uploads/2023/10/Volunteering-mental-health-charity-Blog-static-Oct-23.png" alt="Nutrition Awareness" />
        <div class="slide-caption">
          <h3>Nutrition Awareness</h3>
          <p>Educate communities about healthy eating habits and lifestyles</p>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="slider-slide">
        <img src="https://www.verywellmind.com/thmb/Iw6lwqT-yWl4IsWWjhoos1phmf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/GettyImages-1311247736-2e9719c1e2424dda85dc362ab66e1d17.jpg" alt="Fitness & Wellness" />
        <div class="slide-caption">
          <h3>Fitness & Wellness</h3>
          <p>Engage people in fitness programs to promote well-being</p>
        </div>
      </div>
    </div>
    <!-- Navigation Buttons -->
    <button class="slider-btn prev" onclick="moveSlide(-1)">❮</button>
    <button class="slider-btn next" onclick="moveSlide(1)">❯</button>
  </div>

  <!-- Back to Events Button -->
  <div style="text-align:center;">
 <a href="/volunteer" class="back-btn">Back to Dashboard</a>
</div>
</section>

<footer class="main-footer">
  <div class="footer-bottom">
    © 2024 Resource Education And Charitable Trust (REACT). All rights reserved.
  </div>
</footer>

<script>
let currentIndex = 0;
const slides = document.querySelectorAll('.slider-slide');

function showSlide(index){
  if(index < 0) currentIndex = slides.length - 1;
  else if(index >= slides.length) currentIndex = 0;
  else currentIndex = index;
  const wrapper = document.getElementById('sliderWrapper');
  wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
}

function moveSlide(step){
  showSlide(currentIndex + step);
}
// Initialize first slide
showSlide(0);
</script>
</body>
</html>
