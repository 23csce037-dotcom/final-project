<!DOCTYPE html>
<html>

<head>
    <title>Resume & Skills</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            background: #eef2ff;
        }

        /* ================= NAVBAR ================= */
        .navbar {
            background: linear-gradient(90deg, #667eea, #764ba2);
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-weight: bold;
            font-size: 16px;
        }

        .nav-links a:hover {
            text-decoration: underline;
        }

        /* ================= PAGE ================= */
        .container {
            max-width: 650px;
            margin: 45px auto;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        h2 {
            color: #2c5aa0;
            margin-bottom: 10px;
        }

        h3 {
            margin-top: 25px;
            color: #444;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 6px;
        }

        input[type="text"],
        select,
        input[type="file"],
        textarea {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 18px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
            box-sizing: border-box;
            font-family: Arial;
        }

        textarea {
            resize: vertical;
            min-height: 130px;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 4px rgba(102, 126, 234, 0.4);
        }

        button {
            background: #667eea;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            transition: 0.3s;
        }

        button:hover {
            background: #5a67d8;
        }

        p {
            background: #f4f6ff;
            padding: 8px;
            border-radius: 5px;
            font-size: 14px;
        }

        small {
            color: gray;
        }

        .success-message{
        background:#d4edda;
        color:#155724;
        padding:12px;
        border-radius:6px;
        margin-bottom:15px;
        border:1px solid #c3e6cb;
        font-weight:bold;
        text-align:center;
        }

    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <div class="navbar">
        <div class="logo">
          <img
            src="/images/logo.jpeg"
            alt="REACT Logo"
            style="
              height: 45px;
              width: auto;
              vertical-align: middle;
              margin-right: 0.4rem;
            "
          />REACT
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/pwd">Dashboard</a>
            <a href="/logout">Logout</a>
        </div>
    </div>

    <!-- ================= CONTENT ================= -->
    <div class="container">

        <h2>Resume & Skills</h2>
            <% if (typeof success !== "undefined") { %>
            <div class="success-message">
                <%= success %>
            </div>
            <% } %>
        <form action="/resume" method="POST" enctype="multipart/form-data">

            <h3>Candidate Details</h3>

            <label>Full Name</label>
            <input type="text" name="fullName" value="<%= resume ? resume.fullName : '' %>" required>

            <label>Education</label>
            <input type="text" name="education" value="<%= resume ? resume.education : '' %>" required>

            <label>Experience</label>
            <select name="experience">
                <option>Fresher</option>
                <option>1-2 Years</option>
                <option>3-5 Years</option>
                <option>5+ Years</option>
            </select>

            <label>Preferred Job Role</label>
            <input type="text" name="preferredJobRole" value="<%= resume ? resume.preferredJobRole : '' %>">

            <label>Disability Type</label>
            <input type="text" name="disabilityType" value="<%= resume ? resume.disabilityType : '' %>">

            <!-- Resume Upload -->
            <h3>Upload Resume (PDF)</h3>

            <input type="file" name="resumeFile">

            <% if (resume && resume.resumeFile) { %>
                <p><b>Uploaded File:</b>
                    <%= resume.resumeFile %>
                </p>
                <% } %>

                    <!-- ================= SKILLS (NEW DESIGN) ================= -->
                    <h3>Skills & Abilities</h3>

                    <label>Enter Your Skills</label>

                   <textarea name="skills" placeholder="Example: One Skill Per line
Communication
Teaching
Driving
MS Office
Tailoring
Customer Service"><%= resume && Array.isArray(resume.skills) ? resume.skills.join('\n') : (resume ? resume.skills : '') %></textarea>
                    <small>
                        You can enter technical or non-technical skills. One skill per line.
                    </small>

                    <br><br>

                    <button type="submit">Save Resume</button>

        </form>

    </div>

</body>

</html>