<!DOCTYPE html>
<html>
<head>
<title>Admin Feedback - REACT</title>

<style>
*, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }

body{
    font-family:"Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background:rgb(242, 244, 247);
    min-height:100vh;
    display:flex;
    flex-direction:column;
}

/* HEADER */
header{
    background: linear-gradient(135deg,#667eea,#764ba2);
    padding:0.5rem 0;
    box-shadow:0 4px 20px rgba(0,0,0,0.1);
}

nav{
    max-width:1200px;
    margin:0 auto;
    display:flex;
    align-items:center;
    padding:10px 20px;
}

.logo{
    font-size:1.5rem;
    font-weight:bold;
    color:#f2f4f7ff;
}

.nav-links{
    margin-left:auto;
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    text-decoration:none;
    color:white;
    font-weight:500;
    font-size:16px;
}

/* PAGE */
.dashboard-container{
    width:90%;
    max-width:1400px;
    margin:40px auto;
    padding:20px;
    flex:1;
}

h2{
    color:#2c5aa0;
    margin-bottom:20px;
    font-size:26px;
}

/* TABLE WRAPPER */
.table-wrap{
    background:white;
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 6px 32px rgba(102,126,234,0.2);
    width:100%;
    max-width:1100px;
    margin:0 auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

/* TABLE HEADER */
thead tr{
    background: linear-gradient(135deg,#667eea,#764ba2);
}

thead th{
    padding:16px 18px;
    text-align:left;
    font-size:14px;
    font-weight:600;
    color:rgba(255,255,255,0.9);
    letter-spacing:0.8px;
    text-transform:uppercase;
}

/* BODY */
tbody tr{
    border-bottom:1px solid #eaecf8;
}

tbody tr:nth-child(even){
    background:#f6f7ff;
}

tbody tr:hover{
    background:#eef1ff;
}

td{
    padding:18px 18px;
    font-size:15px;
    color:#333;
}

/* empty state */
.empty td{
    text-align:center;
    padding:60px;
    color:#888;
    font-size:14px;
}

/* ── FOOTER (original) ── */
footer 
   {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #f2f4f7ff;
        text-align: center;
        padding: 20px 0;
        margin-top: 40px;
        font-size: 13px;
    }

</style>
</head>

<body>

<header>
<nav>
<div class="logo">
          <img
            src="/images/logo.jpeg"
            alt="REACT Logo"
            style="
              height: 45px;
              width: auto;
              vertical-align: middle;
              margin-right: 0.4rem;
            "
          />REACT
        </div>

<ul class="nav-links">
<li><a href="/">Home</a></li>
<li><a href="/admin">Dashboard</a></li>
<li><a href="/logout">Logout</a></li>
</ul>

</nav>
</header>

<div class="dashboard-container">

<h2>User Feedback</h2>

<div class="table-wrap">
<table>

<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Message</th>
<th>Date</th>
</tr>
</thead>

<tbody>

<% if (feedbacks && feedbacks.length > 0) { %>

    <% feedbacks.forEach(function(feedback){ %>

    <tr>
        <td><%= feedback.name %></td>
        <td><%= feedback.email %></td>
        <td><%= feedback.message %></td>
        <td><%= feedback.createdAt.toDateString() %></td>
    </tr>

    <% }) %>

<% } else { %>

<tr class="empty">
<td colspan="4">No feedback available.</td>
</tr>

<% } %>

</tbody>

</table>
</div>

</div>

<footer>
© 2026 REACT | Admin Feedback
</footer>

</body>
</html>