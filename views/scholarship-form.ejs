<!DOCTYPE html>
<html>

<head>
    <title>Scholarship Application - REACT</title>

    <style>
        body {
            font-family: "Segoe UI", Tahoma;
            margin: 0;
            background: #f4f6fb;
        }

        header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            padding: 10px 0;
        }

        nav {
            max-width: 1200px;
            margin: auto;
            display: flex;
            align-items: center;
            padding: 10px 20px;
        }

        .logo {
            color: white;
            font-size: 22px;
            font-weight: bold;
        }

        .nav-links {
            margin-left: auto;
            list-style: none;
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
        }

        .container {
            max-width: 700px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        button {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .success-message{
        background:#d4edda;
        color:#155724;
        padding:12px;
        border-radius:6px;
        margin-bottom:15px;
        border:1px solid #c3e6cb;
        font-weight:bold;
        text-align:center;
        }

        .error-message{
        background:#f8d7da;
        color:#721c24;
        padding:12px;
        border-radius:6px;
        margin-bottom:15px;
        border:1px solid #f5c6cb;
        font-weight:bold;
        text-align:center;
        }
    </style>
</head>

<body>

    <header>
        <nav>
            <div class="logo">REACT</div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/pwd">Dashboard</a></li>
                <li><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">

        <h2>Scholarship Application Form</h2>
            <% if (typeof success !== "undefined") { %>
            <div class="success-message">
                <%= success %>
            </div>
            <% } %>

            <% if (typeof error !== "undefined") { %>
            <div class="error-message">
                <%= error %>
            </div>
            <% } %>
        <form action="/scholarship/apply" method="POST">

            <label>Degree</label>
            <input type="text" name="degree" value="<%= data ? data.degree : '' %>" required>

            <label>CGPA / Percentage</label>
            <input type="number" step="0.01" name="cgpa" value="<%= data ? data.cgpa : '' %>" required>

            <label>Year of Passing</label>
            <input type="number" name="passout" value="<%= data ? data.passout : '' %>" required>

            <label>College Name</label>
            <input type="text" name="college" value="<%= data ? data.college : '' %>" required>

            <label>Contact Number</label>
            <input type="text" name="phone" value="<%= data ? data.phone : '' %>" required>

            <button type="submit">
                <%= data ? "Update Application" : "Submit Application" %>
            </button>

        </form>

    </div>

</body>

</html>