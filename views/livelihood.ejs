<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Livelihood Development – REACT</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --blue: #3f5fc0;
        --blue-dark: #2d4aad;
        --purple: #7b4fc9;
        --grad: linear-gradient(135deg, #4a6bd6 0%, #7b4fc9 100%);
        --grad-hero: linear-gradient(135deg, #4a6bd6 0%, #9b59c9 100%);
        --white: #ffffff;
        --bg: #f8f9fc;
        --text: #333344;
        --text-muted: #666680;
        --card-h: 460px;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: "Nunito Sans", "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        overflow-x: hidden;
      }
      /* ── NAV ── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100;
        background: var(--white);
        border-bottom: 1px solid rgba(63, 95, 192, 0.1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 48px;
        height: 64px;
        box-shadow: 0 2px 12px rgba(63, 95, 192, 0.08);
      }
      .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .nav-logo {
        font-size: 22px;
        font-weight: 800;
        color: var(--blue-dark);
        letter-spacing: 2px;
        text-transform: uppercase;
      }
      .nav-name {
        font-size: 15px;
        color: var(--blue-dark);
        font-weight: 700;
      }
      .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
      }
      .nav-links a {
        font-size: 13.5px;
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
      }
      .nav-links a:hover {
        color: var(--blue);
      }
      /* ── PARALLAX HERO ── */
      .hero {
        min-height: 38vh;
        background: var(--grad-hero);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        padding: 100px 48px 48px;
        text-align: center;
      }
      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(
            ellipse 60% 50% at 15% 25%,
            rgba(255, 255, 255, 0.1) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse 50% 60% at 85% 75%,
            rgba(255, 255, 255, 0.06) 0%,
            transparent 55%
          );
      }
      .hero-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 56px 56px;
      }
      .hero-eyebrow {
        font-size: 10px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.75);
        margin-bottom: 8px;
        position: relative;
        font-weight: 700;
      }
      .hero h1 {
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 800;
        color: var(--white);
        line-height: 1.1;
        position: relative;
      }
      .hero-sub {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.9);
        margin-top: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
        position: relative;
      }
      .hero-body {
        max-width: 700px;
        margin-top: 32px;
        position: relative;
        font-size: 16px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 400;
      }
      .hero-scroll {
        position: absolute;
        bottom: 36px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 10px;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        animation: bob 2s ease-in-out infinite;
      }
      .hero-scroll::after {
        content: "";
        width: 1px;
        height: 44px;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.5),
          transparent
        );
      }
      @keyframes bob {
        0%,
        100% {
          transform: translateX(-50%) translateY(0);
        }
        50% {
          transform: translateX(-50%) translateY(8px);
        }
      }
      /* ── SECTION ── */
      .section {
        padding: 90px 48px;
        background: var(--bg);
      }
      .section-label {
        font-size: 11px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 48px;
        text-align: center;
        font-weight: 700;
      }
      /* ── CARDS GRID ── */
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 28px;
        max-width: 1280px;
        margin: 0 auto;
      }
      /* ── FLIP CARD ── */
      .flip-card {
        height: var(--card-h);
        perspective: 1200px;
        cursor: pointer;
      }
      .flip-card-inner {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(63, 95, 192, 0.13);
      }
      .flip-card:hover .flip-card-inner,
      .flip-card.flipped .flip-card-inner {
        transform: rotateY(180deg);
      }
      .flip-front,
      .flip-back {
        position: absolute;
        inset: 0;
        border-radius: 14px;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        overflow: hidden;
      }
      /* FRONT */
      .flip-front {
        background: var(--white);
      }
      .flip-front img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: brightness(0.86) saturate(0.95);
        transition:
          filter 0.4s,
          transform 0.6s;
      }
      .flip-card:hover .flip-front img {
        filter: brightness(0.7) saturate(1.05);
        transform: scale(1.04);
      }
      .flip-front-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(
          to top,
          rgba(45, 74, 173, 0.92) 0%,
          rgba(74, 107, 214, 0.3) 65%,
          transparent 100%
        );
        padding: 28px 26px 24px;
      }
      .flip-front-title {
        font-size: 19px;
        font-weight: 700;
        color: var(--white);
        line-height: 1.3;
      }
      .flip-front-hint {
        font-size: 10.5px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.7);
        margin-top: 7px;
        font-weight: 600;
      }
      .flip-number {
        position: absolute;
        top: 16px;
        right: 18px;
        font-size: 52px;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.12);
        line-height: 1;
      }
      /* BACK */
      .flip-back {
        transform: rotateY(180deg);
        background: var(--grad);
        display: flex;
        flex-direction: column;
        padding: 36px 28px;
        justify-content: space-between;
      }
      .flip-back-num {
        font-size: 68px;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.08);
        line-height: 1;
        margin-bottom: -12px;
      }
      .flip-back-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--white);
        margin-bottom: 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.25);
        padding-bottom: 14px;
      }
      .flip-back-text {
        font-size: 14px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 400;
      }
      .flip-back-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        border-top: 1px solid rgba(255, 255, 255, 0.18);
        padding-top: 14px;
        font-size: 10.5px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 600;
      }
      .flip-back-footer span {
        color: rgba(255, 255, 255, 0.9);
        font-size: 14px;
      }
      /* PARALLAX */
      .parallax-wrap {
        position: relative;
      }
      .parallax-deco {
        position: absolute;
        top: -80px;
        right: -60px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(123, 79, 201, 0.07) 0%,
          transparent 70%
        );
        pointer-events: none;
      }
      .parallax-deco2 {
        position: absolute;
        bottom: -60px;
        left: -80px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(74, 107, 214, 0.06) 0%,
          transparent 70%
        );
        pointer-events: none;
      }
      /* ── CTA BANNER ── */
      .contact-bar {
        background: var(--grad);
        text-align: center;
        padding: 56px 48px;
        position: relative;
        overflow: hidden;
      }
      .contact-bar::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
          ellipse 60% 80% at 50% 50%,
          rgba(255, 255, 255, 0.08) 0%,
          transparent 70%
        );
      }
      .contact-bar h2 {
        font-size: 28px;
        font-weight: 800;
        color: var(--white);
        margin-bottom: 12px;
        position: relative;
      }
      .contact-bar p {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 28px;
        position: relative;
        font-weight: 400;
      }
      .cta-btn {
        display: inline-block;
        background: var(--white);
        color: var(--blue);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        padding: 14px 40px;
        border-radius: 40px;
        position: relative;
        transition:
          transform 0.2s,
          box-shadow 0.2s;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }
      .cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
      }
      footer {
        background: var(--white);
        text-align: center;
        padding: 20px 48px;
        font-size: 13px;
        color: var(--text-muted);
        border-top: 1px solid rgba(63, 95, 192, 0.08);
      }
      footer strong {
        color: var(--blue-dark);
        font-weight: 700;
      }
      /* RESPONSIVE */
      @media (max-width: 768px) {
        nav {
          padding: 0 20px;
        }
        .nav-links {
          display: none;
        }
        .hero {
          padding: 100px 24px 60px;
        }
        .section {
          padding: 60px 24px;
        }
        .cards-grid {
          grid-template-columns: 1fr;
        }
        :root {
          --card-h: 420px;
        }
      }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <nav>
        <div class="logo">
          <img
            src="/images/logo.jpeg"
            alt="REACT Logo"
            style="
              height: 45px;
              width: auto;
              vertical-align: middle;
              margin-right: 0.4rem;
            "
          />REACT
        </div>
      <ul class="nav-links" id="navLinks">
        <li><a href="/">Home</a></li>
        <li><a href="/login">Login</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/programs">Programs</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/user">Events</a></li>
        <li><a href="/register">Get Involved</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </nav>
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-grid-bg"></div>
      <p class="hero-eyebrow">REACT — Madurai</p>
      <h1>Livelihood<br />Development</h1>
      <p class="hero-sub">Securing Sustainable Futures Through Employment</p>
      <p class="hero-body">
        Our Livelihood Program is dedicated to empowering people with
        disabilities in Madurai by facilitating access to meaningful employment
        and self-employment opportunities. We work closely with both educated
        and less educated youth with disabilities, leveraging our strong network
        of over 75 committed companies and collaborations with local NGOs,
        government institutions, and private associations.
      </p>
      <div class="hero-scroll">Scroll</div>
    </section>
    <!-- FLIPPING CARDS -->
    <section class="section parallax-wrap" id="services">
      <div class="parallax-deco"></div>
      <div class="parallax-deco2"></div>
      <div class="cards-grid">
        <!-- Card 1 -->
        <div
          class="flip-card"
          tabindex="0"
          onclick="this.classList.toggle('flipped')"
          onkeypress="
            if (event.key === 'Enter') this.classList.toggle('flipped');
          "
        >
          <div class="flip-card-inner">
            <div class="flip-front">
              <!-- Counselling: outdoor group meeting image -->
              <img
                src="https://images.unsplash.com/photo-1529390079861-591de354faf5?w=700&q=80"
                alt="Counselling and Career Guidance"
                loading="lazy"
              />
              <div class="flip-number">01</div>
              <div class="flip-front-overlay">
                <div class="flip-front-title">
                  Counselling and Career Guidance
                </div>
                <div class="flip-front-hint">Hover to learn more →</div>
              </div>
            </div>
            <div class="flip-back">
              <div class="flip-back-top">
                <div class="flip-back-num">01</div>
                <div class="flip-back-title">
                  Counselling and Career Guidance
                </div>
                <p class="flip-back-text">
                  We begin by thoroughly evaluating the skills, interests, and
                  aspirations of each candidate to identify suitable job roles.
                  Our experienced counselors provide personalized guidance,
                  offering support in career planning and assisting individuals
                  in preparing themselves effectively for their chosen career
                  paths.
                </p>
              </div>
              <div class="flip-back-footer">
                <span>✦</span> Career Planning &amp; Assessment
              </div>
            </div>
          </div>
        </div>
        <!-- Card 2 -->
        <div
          class="flip-card"
          tabindex="0"
          onclick="this.classList.toggle('flipped')"
          onkeypress="
            if (event.key === 'Enter') this.classList.toggle('flipped');
          "
        >
          <div class="flip-card-inner">
            <div class="flip-front">
              <!-- Job skills training: entrance / walk-in image -->
              <img
                src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=700&q=80"
                alt="Job Skills Training"
                loading="lazy"
              />
              <div class="flip-number">02</div>
              <div class="flip-front-overlay">
                <div class="flip-front-title">Job Skills Training</div>
                <div class="flip-front-hint">Hover to learn more →</div>
              </div>
            </div>
            <div class="flip-back">
              <div class="flip-back-top">
                <div class="flip-back-num">02</div>
                <div class="flip-back-title">Job Skills Training</div>
                <p class="flip-back-text">
                  REACT has established strategic partnerships with the District
                  Skill Training Office, private training institutions, and NGOs
                  to provide relevant and industry-aligned training to people
                  with disabilities. This includes comprehensive interview
                  preparation and essential soft skills training, totaling 100
                  hours, designed to enhance their employability and confidence.
                </p>
              </div>
              <div class="flip-back-footer">
                <span>✦</span> 100 Hours of Training
              </div>
            </div>
          </div>
        </div>
        <!-- Card 3 -->
        <div
          class="flip-card"
          tabindex="0"
          onclick="this.classList.toggle('flipped')"
          onkeypress="
            if (event.key === 'Enter') this.classList.toggle('flipped');
          "
        >
          <div class="flip-card-inner">
            <div class="flip-front">
              <!-- Placement assistance: waiting / interview scene -->
              <img
                src="https://images.unsplash.com/photo-1551836022-deb4988cc6c0?w=700&q=80"
                alt="Placement Assistance"
                loading="lazy"
              />
              <div class="flip-number">03</div>
              <div class="flip-front-overlay">
                <div class="flip-front-title">Placement Assistance</div>
                <div class="flip-front-hint">Hover to learn more →</div>
              </div>
            </div>
            <div class="flip-back">
              <div class="flip-back-top">
                <div class="flip-back-num">03</div>
                <div class="flip-back-title">Placement Assistance</div>
                <p class="flip-back-text">
                  We actively collaborate with our extensive network of over 75
                  companies in Madurai to secure job opportunities for people
                  with disabilities. REACT organizes various recruitment events,
                  including on-campus, off-campus, and walk-in job interviews,
                  to connect talented individuals with inclusive employers.
                </p>
              </div>
              <div class="flip-back-footer">
                <span>✦</span> 75+ Partner Companies
              </div>
            </div>
          </div>
        </div>
        <!-- Card 4 -->
        <div
          class="flip-card"
          tabindex="0"
          onclick="this.classList.toggle('flipped')"
          onkeypress="
            if (event.key === 'Enter') this.classList.toggle('flipped');
          "
        >
          <div class="flip-card-inner">
            <div class="flip-front">
              <!-- Self employment: small business / workshop setting -->
              <img
                src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=700&q=80"
                alt="Self Employment Assistance"
                loading="lazy"
              />
              <div class="flip-number">04</div>
              <div class="flip-front-overlay">
                <div class="flip-front-title">Self Employment Assistance</div>
                <div class="flip-front-hint">Hover to learn more →</div>
              </div>
            </div>
            <div class="flip-back">
              <div class="flip-back-top">
                <div class="flip-back-num">04</div>
                <div class="flip-back-title">Self Employment Assistance</div>
                <p class="flip-back-text">
                  Recognizing the potential for entrepreneurship, REACT partners
                  with the District Disability Rehabilitation Office to guide
                  people with disabilities interested in pursuing
                  self-employment. We provide comprehensive support throughout
                  the application process for government funding and other
                  resources available for such ventures.
                </p>
              </div>
              <div class="flip-back-footer">
                <span>✦</span> Entrepreneurship Support
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- CONTACT CTA -->
    <div class="contact-bar">
      <h2>Ready to Make a Difference?</h2>
      <p>
        Join us in creating lasting change in our community. Let's work together
        to build a more inclusive and accessible world for everyone.
      </p>
      <a href="#" class="cta-btn">GET INVOLVED</a>
    </div>
    <footer>
      <strong
        >The site is managed by Resource Education And Charitable Trust -
        Madurai</strong
      >
    </footer>
    <script>
      // Subtle parallax on scroll for the hero text
      window.addEventListener("scroll", () => {
        const scrollY = window.scrollY;
        const hero = document.querySelector(".hero");
        if (hero) {
          hero.style.backgroundPositionY = `${scrollY * 0.4}px`;
        }
        // Parallax deco blobs
        const deco = document.querySelector(".parallax-deco");
        const deco2 = document.querySelector(".parallax-deco2");
        if (deco) deco.style.transform = `translateY(${scrollY * -0.12}px)`;
        if (deco2) deco2.style.transform = `translateY(${scrollY * 0.08}px)`;
      });
      // Intersection observer: animate cards in on scroll
      const cards = document.querySelectorAll(".flip-card");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              entry.target.style.opacity = "1";
              entry.target.style.transform = "translateY(0)";
            }
          });
        },
        { threshold: 0.15 },
      );
      cards.forEach((card, i) => {
        card.style.opacity = "0";
        card.style.transform = "translateY(48px)";
        card.style.transition = `opacity .6s ease ${i * 0.12}s, transform .6s ease ${i * 0.12}s`;
        observer.observe(card);
      });
    </script>
  </body>
</html>
