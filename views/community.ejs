<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Community Development - REACT</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}

body{
  font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
  background:#f4f6f9;
  line-height:1.6;
  color:#333;
}

/* HERO */
.hero{
  background: linear-gradient(135deg,#667eea,#764ba2);
  color:white;
  padding:3rem;
  text-align:center;
}

.hero h1{
  font-size:2.3rem;
}

/* CONTAINER */
.container{
  max-width:1000px;
  margin:3rem auto;
  padding:2rem;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:2rem;
}

/* CARD */
.card{
  background:white;
  padding:2rem;
  border-radius:15px;
  text-align:center;
  cursor:pointer;
  box-shadow:0 5px 20px rgba(0,0,0,0.1);
  transition:0.3s;
}

.card:hover{
  transform:translateY(-8px);
}

.btn{
  display:inline-block;
  margin-top:1rem;
  padding:0.6rem 1.5rem;
  background:#667eea;
  color:white;
  border-radius:5px;
  text-decoration:none;
}

/* BACK BUTTON */
.back-wrapper{
  text-align:center;
  margin-top:3rem;
}

.back-btn{
  display:inline-block;
  padding:0.7rem 1.5rem;
  background:linear-gradient(135deg,#667eea,#764ba2);
  color:white;
  text-decoration:none;
  border-radius:6px;
  transition:0.3s;
}

.back-btn:hover{
  opacity:0.9;
}

/* FOOTER */
.main-footer{
  background:#34495e;
  color:#ffffff;
  padding:3rem 2rem 2rem;
  margin-top:4rem;
}
.footer-bottom{
  text-align:center;
  margin-top:2rem;
  border-top:1px solid rgba(255,255,255,0.2);
  padding-top:1rem;
  font-size:0.9rem;
}
</style>
</head>
<body>
<div class="hero">
  <h1>Community Development</h1>
</div>

<div class="container">
  <div class="grid">
    <!-- Volunteer Interview -->
    <div class="card" onclick="window.location.href='/volunteer/interview'">
      <h2>Volunteer Interviews</h2>
      <p>Apply and attend interview to join our volunteering programs.</p>
      <span class="btn">Apply Now</span>
    </div>
  </div>

  <!-- Back Button -->
  <div class="back-wrapper">
    <a href="/Volunteer" class="back-btn">Back to Dashboard</a>
  </div>
</div>
<footer class="main-footer">
  <div class="footer-bottom">
    © 2024 Resource Education And Charitable Trust (REACT). All rights reserved.
  </div>
</footer>
</body>
</html>
