<!DOCTYPE html>
<html>

<head>
    <title>Add Job</title>
</head>

<body>

    <h2>Add Job Opportunity</h2>

    <form action="/admin/jobs/add" method="POST">

        <input type="text" name="jobTitle" placeholder="Job Title" required><br><br>

        <input type="text" name="company" placeholder="Company" required><br><br>

        <input type="text" name="location" placeholder="Location"><br><br>

        <input type="text" name="jobType" placeholder="Job Type"><br><br>

        <input type="text" name="salary" placeholder="Salary"><br><br>

        <textarea name="description" placeholder="Job Description"></textarea><br><br>

        <button type="submit">Add Job</button>

    </form>

</body>

</html>